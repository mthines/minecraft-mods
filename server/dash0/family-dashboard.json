                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(increase({otel_metric_name=\"dash0.logs\", event_name=\"minecraft.block.broken\", minecraft_block_category=\"ore\"}[$__range])) or vector(0)"

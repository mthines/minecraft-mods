                    "seriesNameFormat": "{{minecraft_mob_type}} · {{minecraft_death_cause}}"
                  }
                }
              }
            }
          ]
        }
      },
      "bounceHeight": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🚀 How high we bounced",
            "description": "Bounces by how high the trampoline launches you. Bigger trampolines bounce higher."
          },
          "plugin": {
            "kind": "PieChart",
            "spec": {
              "calculation": "last",
              "legend": {
                "position": "right",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (minecraft_trampoline_height_blocks) (increase({otel_metric_name=\"dash0.logs\", service_name=\"bedrock-server\", event_name=\"minecraft.trampoline.bounce\"}[$__range]))",
                    "seriesNameFormat": "{{minecraft_trampoline_height_blocks}} blocks high"
                  }
                }
              }
            }
          ]
        }
      },
      "activity": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "📈 What we were doing, and when",
            "description": "Game events over time. Tall bars are busy play sessions."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "display": "bar"
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 0
                },
                "min": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "label_replace(sum by (event_name) (increase({otel_metric_name=\"dash0.logs\", service_name=\"bedrock-server\", event_name=~\"minecraft[.](block|mob|player[.]died|trampoline|rainbow_cookie).*\"}[$__interval])), \"what\", \"$1\", \"event_name\", \"minecraft[.](.*)\")",
                    "seriesNameFormat": "{{what}}"
                  }
                }
              }
            }
          ]
        }
      },
      "cpu": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🖥️ How hard the server is working (CPU)",
            "description": "CPU used by the bedrock-server container. About 0.4% when nobody is playing."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "percent",
                  "decimalPlaces": 1
                },
                "min": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "avg by (service_name) ({otel_metric_name=\"container.cpu.utilization\", service_name=\"bedrock-server\"})",
                    "seriesNameFormat": "{{service_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "memory": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🧠 Server memory",
            "description": "Memory used by the bedrock-server container. About 2 GB when this dashboard was built."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "bytes",
                  "decimalPlaces": 1
                },
                "min": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "max by (service_name) ({otel_metric_name=\"container.memory.usage.total\", service_name=\"bedrock-server\"})",
                    "seriesNameFormat": "{{service_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "restarts": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🔄 Server starts",
            "description": "Times the server started (./mc start, restart, or a dev reload)."

            },
            {
              "x": 12,
              "y": 0,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/bounces"
              }
            },
            {
              "x": 18,
              "y": 0,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/mobs"
              }
            },
            {
              "x": 0,
              "y": 4,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/deaths"
              }
            },
            {
              "x": 6,
              "y": 4,
              "width": 6,
              "height": 4,

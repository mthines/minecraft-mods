      "errors": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🐞 Server error lines",
            "description": "ERROR lines in the server log. Most are 'No targets matched selector' from ./mc kit when nobody is online, which is harmless."
          },
          "plugin": {
            "kind": "StatChart",

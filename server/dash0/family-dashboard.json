      "errors": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🐞 Server errors"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last",
              "format": {
                "unit": "decimal",
                "decimalPlaces": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(increase({otel_metric_name=\"dash0.logs\", service_name=\"bedrock-server\", otel_log_severity_range=\"ERROR\"}[$__range])) or vector(0)"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}

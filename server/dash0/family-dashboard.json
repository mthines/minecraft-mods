              },
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (minecraft_player_name) (increase({otel_metric_name=\"dash0.logs\", event_name=\"minecraft.mob.killed\"}[$__range]))",
                    "seriesNameFormat": "{{minecraft_player_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "whatDug": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🪨 What we dug"
          },
          "plugin": {
            "kind": "PieChart",
            "spec": {
              "calculation": "last",
              "legend": {
                "position": "right",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (minecraft_block_category) (increase({otel_metric_name=\"dash0.logs\", event_name=\"minecraft.block.broken\"}[$__range]))",
                    "seriesNameFormat": "{{minecraft_block_category}}"
                  }
                }
              }
            }
          ]
        }
      },
      "whatBeat": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🧟 Mobs we beat"
          },
          "plugin": {
            "kind": "PieChart",
            "spec": {
              "calculation": "last",
              "legend": {
                "position": "right",
                "mode": "list"
              }
            }
          },

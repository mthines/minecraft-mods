              "height": 4,
              "content": {
                "$ref": "#/spec/panels/cookies"
              }
            },
            {
              "x": 0,
              "y": 11,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/digLeaders"
              }
            },
            {
              "x": 8,
              "y": 11,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/buildLeaders"
              }
            },
            {
              "x": 16,
              "y": 11,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/fightLeaders"
              }
            },
            {
              "x": 0,
              "y": 19,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/whatDug"
              }
            },
            {
              "x": 8,
              "y": 19,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/whatBeat"

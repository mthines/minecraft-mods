{
  "kind": "Dashboard",
  "metadata": {
    "name": "bedrock-server-family-fun-stats",
    "project": "minecraft"
  },
  "spec": {
    "display": {
      "name": "⛏️ Family Server – Fun Stats",
      "description": "What everyone dug, built, bounced, beat, and how they got got, on the family Minecraft Bedrock server. Subject: service_name=bedrock-server game events (dash0.logs grouped by event_name)."
    },
    "duration": "24h",
    "refreshInterval": "1m",
    "panels": {
      "intro": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "## 👋 Welcome to the Family Server stats!\nEvery block you dig, everything you build, every trampoline bounce and every creeper fight shows up here. Pick a time in the top right: **Last 24 hours** is today, **Last 7 days** is the whole week. Numbers update every minute while you play.\n"
            }
          }
        }
      },
      "dug": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "⛏️ Blocks dug",
            "description": "Blocks broken by anyone: digging, chopping, mining."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last",
              "format": {
                "unit": "decimal",
                "decimalPlaces": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(increase({otel_metric_name=\"dash0.logs\", service_name=\"bedrock-server\", event_name=\"minecraft.block.broken\"}[$__range])) or vector(0)"
                  }
                }
              }
            }
          ]
        }
      },
      "placed": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🧱 Blocks built",
            "description": "Blocks placed by anyone."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last",
              "format": {
                "unit": "decimal",
                "decimalPlaces": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(increase({otel_metric_name=\"dash0.logs\", service_name=\"bedrock-server\", event_name=\"minecraft.block.placed\"}[$__range])) or vector(0)"
                  }
                }
              }
            }
          ]
        }
      },
      "bounces": {

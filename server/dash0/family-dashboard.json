      "digLeaders": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🏆 Best diggers",
            "description": "Blocks dug per player."
          },
          "plugin": {
            "kind": "PieChart",
            "spec": {
              "calculation": "last",
              "legend": {
                "position": "right",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "topk(10, sum by (minecraft_player_name) (increase({otel_metric_name=\"dash0.logs\", service_name=\"bedrock-server\", event_name=\"minecraft.block.broken\"}[$__range])))",
                    "seriesNameFormat": "{{minecraft_player_name}}"
                  }
                }
              }
            }
          ]
        }
      },

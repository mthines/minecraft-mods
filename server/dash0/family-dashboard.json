              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(increase({otel_metric_name=\"dash0.logs\", event_name=\"minecraft.rainbow_cookie.eaten\"}[$__range])) or vector(0)"
                  }
                }
              }
            }
          ]
        }
      },
      "digLeaders": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🏆 Best diggers"
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last",
              "format": {
                "unit": "decimal",
                "decimalPlaces": 0
              },
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (minecraft_player_name) (increase({otel_metric_name=\"dash0.logs\", event_name=\"minecraft.block.broken\"}[$__range]))",
                    "seriesNameFormat": "{{minecraft_player_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "buildLeaders": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🏗️ Best builders"
          },

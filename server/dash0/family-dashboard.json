            },
            {
              "x": 16,
              "y": 19,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/whatGotUs"
              }
            },
            {
              "x": 0,
              "y": 27,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/activity"
              }
            },
            {
              "x": 0,
              "y": 35,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/cpu"
              }
            },
            {
              "x": 12,
              "y": 35,
              "width": 6,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/healed"
              }
            },
            {
              "x": 18,
              "y": 35,
              "width": 6,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/errors"
              }
            }
          ]
        }
      }
    ],
    "panels": {
      "intro": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": ""
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "## ⛏️ What happened on the Family Server?\nEvery time someone digs, builds, fights, or bounces, the server writes it down. Those notes travel to Dash0, which counts them and draws these pictures. That's **observability**: seeing what's going on inside a computer without looking over anyone's shoulder."
            }
          }
        }
      },
      "wood": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🌳 Wood chopped"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last",
              "format": {
                "unit": "decimal",
                "decimalPlaces": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(increase({otel_metric_name=\"dash0.logs\", event_name=\"minecraft.block.broken\", minecraft_block_category=\"wood\"}[$__range])) or vector(0)"
                  }
                }
              }
            }
          ]
        }
      },
      "dug": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "⛏️ Blocks dug"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last",
              "format": {
                "unit": "decimal",
                "decimalPlaces": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(increase({otel_metric_name=\"dash0.logs\", event_name=\"minecraft.block.broken\"}[$__range])) or vector(0)"
                  }
                }
              }
            }
          ]
        }
      },
      "placed": {
        "kind": "Panel",

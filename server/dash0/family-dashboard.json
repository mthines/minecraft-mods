                  }
                }
              }
            }
          ]
        }
      },
      "whatGotUs": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "😵 What got us"
          },
          "plugin": {
            "kind": "PieChart",
            "spec": {
              "calculation": "last",
              "legend": {
                "position": "right",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (minecraft_death_cause) (increase({otel_metric_name=\"dash0.logs\", event_name=\"minecraft.player.died\"}[$__range]))",
                    "seriesNameFormat": "{{minecraft_death_cause}}"
                  }
                }
              }
            }
          ]
        }
      },
      "activity": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "📈 Busy times"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "display": "bar",
                "areaOpacity": 0.4
              },
              "yAxis": {
                "format": {
                  "unit": "decimal"
                },
                "min": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (event_name) (increase({otel_metric_name=\"dash0.logs\", event_name=~\"minecraft\\\\.(block|mob|player\\\\.died|trampoline\\\\.bounce).*\"}[$__interval]))",
                    "seriesNameFormat": "{{event_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "cpu": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🖥️ How hard is the server working? (CPU %)"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "display": "line",
                "areaOpacity": 0.4
              },
              "yAxis": {
                "format": {
                  "unit": "percent"
                },
                "min": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "avg({otel_metric_name=\"container.cpu.utilization\", service_name=\"bedrock-server\"})",
                    "seriesNameFormat": "server"
                  }
                }
              }
            }
          ]
        }
      },
      "healed": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "🩹 Times the server fixed itself"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last",
              "format": {
                "unit": "decimal",
                "decimalPlaces": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(increase({otel_metric_name=\"dash0.logs\", event_name=\"minecraft.server.healed\"}[$__range])) or vector(0)"
                  }
                }
              }
            }

# Copy this file to server/.env and fill it in to send the server's telemetry to Dash0.
# Find both values in Dash0 under Settings → Endpoints and Settings → Auth Tokens.
DASH0_OTLP_ENDPOINT=ingress.eu-west-1.aws.dash0.com:4317
DASH0_AUTH_TOKEN=auth_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: keep the family server's data apart from everything else.
DASH0_DATASET=default

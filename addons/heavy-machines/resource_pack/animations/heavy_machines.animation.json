{
  "format_version": "1.8.0",
  "animations": {
    "animation.family_drill_rig.drill": {
      "loop": true,
      "bones": {
        "drill": {
          "rotation": ["q.property('family:aim') == 1 ? -90 : (q.property('family:aim') == 2 ? 90 : 0)", 0, 0],
          "position": [0, "q.property('family:aim') == 0 ? (3 - q.property('family:drill_size')) * 2 : 0", 0],
          "scale": ["1 + (q.property('family:drill_size') - 3) * 0.15", "1 + (q.property('family:drill_size') - 3) * 0.15", 1]
        },
        "arm": { "scale": "q.property('family:aim') == 0 ? 1 : 0" },
        "bit": { "rotation": [0, 0, "q.property('family:working') ? q.life_time * 720 : 0"] }
      }
    },
    "animation.family_tree_cutter.saw": {
      "loop": true,
      "bones": {
        "blade": { "rotation": [0, "q.property('family:working') ? q.life_time * 900 : 0", 0] }
      }
    }
  }
}
